# Copy this file to `.env` and fill in your values.  cp .env.example .env
# `.env` is git-ignored — never commit real keys.

# ── REQUIRED ─────────────────────────────────────────────
# Free key: https://console.groq.com
GROQ_API_KEY=

# Required while REQUIRE_AUTH=true (the default). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# ── AI model (optional) ──────────────────────────────────
GROQ_MODEL=openai/gpt-oss-120b

# ── Personalisation (optional) ───────────────────────────
BLAZE_CITY=
WEATHER_API_KEY=
NEWS_API_KEY=

# ── Google services: Calendar / Gmail / Drive / Tasks / Sheets ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/callback
GOOGLE_API_KEY=

# ── Spotify (playback needs Premium) ─────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ── Web server (blaze_server.py) ─────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
REQUIRE_AUTH=true
SESSION_TIMEOUT=1800
IP_WHITELIST=
ALLOW_ALL_ORIGINS=false
ENABLE_HTTPS=false
CERT_FILE=
KEY_FILE=

# ── Logging / privacy ────────────────────────────────────
LOG_LEVEL=INFO
ENABLE_REQUEST_LOGGING=true
ENABLE_AUDIT_LOG=true
HISTORY_RETENTION_DAYS=90
ENCRYPT_CONVERSATIONS=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1
DEBUG_MODE=false

# ── Phone mirror (optional, legacy scrcpy embed) ─────────
# BLAZE_ENABLE_SCRCPY_EMBED=1
